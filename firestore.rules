rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        && (!request.resource.data.isVendor
          || request.resource.data.vendorId == userId);
      allow update: if isSelf(userId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.vendorId == resource.data.vendorId;
      allow delete: if isSelf(userId);
    }

    match /vendors/{vendorId} {
      allow read: if isSelf(vendorId);
      allow create: if isSelf(vendorId)
        && request.resource.data.id == vendorId
        && request.resource.data.userId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId;
      allow update: if isSelf(vendorId)
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.id == resource.data.id;
      allow delete: if isSelf(vendorId) && resource.data.userId == request.auth.uid;
    }

    match /public_vendors/{vendorId} {
      allow read: if signedIn();
      allow create, update: if isSelf(vendorId);
      allow delete: if isSelf(vendorId);
    }

    match /emergencies/{emergencyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn() && request.auth.uid == resource.data.userId;
    }
  }
}
